{
  "name": "cubeborn",
  "version": "1.0.0",
  "private": true,
  "description": "Cubeborn - a voxel RPG",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "tsx tools/tests/equipment.ts && tsx tools/tests/weapons.ts && tsx tools/tests/world.ts && tsx tools/tests/save.ts && tsx tools/tests/clock.ts"
  },
  "dependencies": {
    "@fontsource/russo-one": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
